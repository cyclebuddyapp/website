---
// The homepage, shared by /, /es/ and /fr/.
import Base from '../layouts/Base.astro';
import Intro from './Intro.astro';
import Marquee from './Marquee.astro';
import Hero from './sections/Hero.astro';
import How from './sections/How.astro';
import Learn from './sections/Learn.astro';
import AI from './sections/AI.astro';
import Data from './sections/Data.astro';
import Research from './sections/Research.astro';
import BlogPreview from './sections/BlogPreview.astro';
import Mission from './sections/Mission.astro';
import Team from './sections/Team.astro';
import Waitlist from './sections/Waitlist.astro';
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<Base lang={lang} title={s.meta.title} description={s.meta.description} path="/" intro>
  <Intro slot="before" lang={lang} />
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <How lang={lang} />
  <Learn lang={lang} />
  <AI lang={lang} />
  <Data lang={lang} />
  <Research lang={lang} />
  <BlogPreview lang={lang} />
  <Mission lang={lang} />
  <Team lang={lang} />
  <Waitlist lang={lang} />
</Base>
