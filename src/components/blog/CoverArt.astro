---
// Illustrated blog covers. Picked with `art:` in a post's frontmatter; decorative only.
interface Props { name: 'small-ai' }
const { name } = Astro.props;
---
{name === 'small-ai' && (
  <svg class="art" viewBox="0 0 400 260" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <!-- the big AI, far away in the cloud -->
    <g class="cloud">
      <path d="M296 98h66a22 22 0 0 0 0-44 30 30 0 0 0-56-12 24 24 0 0 0-34 22 17 17 0 0 0 24 34z" fill="#fff" opacity=".22" />
      <g fill="#fff" opacity=".55"><circle cx="314" cy="70" r="3" /><circle cx="334" cy="70" r="3" /></g>
      <path d="M316 82q8 -5 16 0" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" opacity=".55" />
    </g>
    <!-- the road to the cloud, closed -->
    <path class="road" d="M232 118 Q262 108 284 96" stroke="#fff" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round" fill="none" opacity=".6" />
    <g class="stop" transform="translate(262 108)">
      <circle r="12" fill="#fff" />
      <path d="M-4.5 -4.5l9 9M4.5 -4.5l-9 9" stroke="#800020" stroke-width="3" stroke-linecap="round" />
    </g>

    <!-- safe boundary around the phone -->
    <circle class="ring" cx="170" cy="140" r="104" fill="#fff" fill-opacity=".07" stroke="#fff" stroke-opacity=".5" stroke-width="2" stroke-dasharray="6 10" />

    <!-- your data, staying home -->
    <g class="orbit"><circle cx="170" cy="40" r="5" fill="#FFD3DF" /><circle cx="170" cy="240" r="4" fill="#fff" opacity=".8" /><circle cx="70" cy="140" r="3.5" fill="#FFD3DF" /></g>

    <!-- the phone -->
    <g class="phone">
      <rect x="122" y="56" width="96" height="170" rx="20" fill="#fff" />
      <rect x="130" y="66" width="80" height="150" rx="13" fill="#FFF1F5" />
      <rect x="156" y="61" width="28" height="4" rx="2" fill="#F2C7D3" />
      <!-- the small AI -->
      <g class="buddy">
        <path d="M170 92v-9" stroke="#C93A66" stroke-width="2.5" stroke-linecap="round" />
        <path class="spark" d="M170 72l2.6 5.4 5.4 2.6-5.4 2.6-2.6 5.4-2.6-5.4-5.4-2.6 5.4-2.6z" fill="#F7A8BE" />
        <rect x="146" y="92" width="48" height="40" rx="16" fill="#800020" />
        <g class="eyes" fill="#fff"><circle cx="161" cy="110" r="4" /><circle cx="179" cy="110" r="4" /></g>
        <path d="M163 120q7 6 14 0" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <circle cx="153" cy="121" r="3" fill="#F06C93" opacity=".8" /><circle cx="187" cy="121" r="3" fill="#F06C93" opacity=".8" />
      </g>
      <!-- chat -->
      <rect class="b1" x="138" y="146" width="52" height="14" rx="7" fill="#F2C7D3" />
      <rect class="b2" x="152" y="166" width="50" height="14" rx="7" fill="#1B716B" opacity=".85" />
      <path class="heart" d="M152 199c-4-3-7-5.5-7-9a4 4 0 0 1 7-2.6 4 4 0 0 1 7 2.6c0 3.5-3 6-7 9z" fill="#CC3466" />
      <rect class="b3" x="164" y="190" width="38" height="12" rx="6" fill="#F2C7D3" />
    </g>

    <!-- lock on the boundary -->
    <g class="lock" transform="translate(96 214)">
      <circle r="17" fill="#fff" />
      <rect x="-7" y="-2" width="14" height="11" rx="2.5" fill="#1B716B" />
      <path d="M-4 -2v-3.5a4 4 0 0 1 8 0V-2" stroke="#1B716B" stroke-width="2.5" fill="none" />
    </g>

    <!-- twinkles -->
    <g fill="#fff">
      <path class="tw t1" d="M52 54l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
      <path class="tw t2" d="M330 196l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
      <path class="tw t3" d="M286 160l1.4 3.6 3.6 1.4-3.6 1.4-1.4 3.6-1.4-3.6-3.6-1.4 3.6-1.4z" />
    </g>
  </svg>
)}

<style>
  .art { width: 100%; height: 100%; display: block; overflow: visible; }
  .art * { transform-box: fill-box; transform-origin: center; }
  .ring { animation: spin 40s linear infinite; }
  .orbit { transform-box: view-box; transform-origin: 170px 140px; animation: spin 18s linear infinite; }
  .phone { animation: float 5s ease-in-out infinite; }
  .buddy { animation: bob 2.6s ease-in-out infinite; }
  .spark { animation: twinkle 2.2s ease-in-out infinite; }
  .eyes { animation: blink 4.5s infinite; }
  .heart { animation: beat 1.6s ease-in-out infinite; }
  .b1, .b2, .b3 { transform-origin: left center; animation: type 6s var(--ease, ease) infinite; }
  .b2 { transform-origin: right center; animation-delay: .6s; }
  .b3 { animation-delay: 1.2s; }
  .cloud { animation: drift 8s ease-in-out infinite; }
  .stop { transform-box: view-box; }
  .stop circle, .stop path { animation: pulse 2.4s ease-in-out infinite; }
  .tw { animation: twinkle 3s ease-in-out infinite; }
  .t2 { animation-delay: -1s; } .t3 { animation-delay: -2s; }
  @media (prefers-reduced-motion: reduce) { .b1, .b2, .b3 { animation: none; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes float { 50% { transform: translateY(-5px); } }
  @keyframes bob { 50% { transform: translateY(-3px) rotate(-3deg); } }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes beat { 15% { transform: scale(1.25); } 30% { transform: scale(1); } }
  @keyframes type { 0% { transform: scaleX(0); opacity: 0; } 12%, 85% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes drift { 50% { transform: translate(6px, -3px); } }
  @keyframes pulse { 50% { transform: scale(1.12); } }
  @keyframes twinkle { 0%, 100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.1); } }
</style>
