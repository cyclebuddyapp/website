---
import PostCard from '../PostCard.astro';
import Icon from '../Icon.astro';
import { postsFor } from '../../data/blog';
import { localize, t, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).blog;
const posts = (await postsFor(lang)).slice(0, 3);
---
<section class="blog" id="blog">
  <div class="wrap">
    <div class="bhead">
      <div>
        <p class="eyebrow reveal">{s.eyebrow}</p>
        <h2 class="reveal" style="--i:1">{s.h}</h2>
      </div>
      <a class="btn btn-ghost reveal" style="--i:2" href={localize(lang, '/blog/')}>{s.all}<Icon name="arrow" size={18} class="arrow" /></a>
    </div>
    <ul class="bgrid" role="list">
      {posts.map((p, i) => <PostCard post={p} lang={lang} i={i} />)}
    </ul>
  </div>
</section>

<style>
  .bhead { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .bgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 46px; list-style: none; }
  @media (max-width: 900px) { .bgrid { grid-template-columns: 1fr; max-width: 520px; } }
</style>
