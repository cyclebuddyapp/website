---
import Icon from '../Icon.astro';
import { localize, t, type Lang } from '../../i18n/utils';
import { LOGO_VIEWBOX, LOGO_A, LOGO_B, LOGO_STROKE } from '../../data/logo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).ai;
---
<section class="ai" id="ai">
  <div class="wrap top">
    <div>
      <p class="eyebrow reveal">{s.eyebrow}</p>
      <h2 class="reveal" style="--i:1">{s.h}</h2>
      <p class="lead reveal" style="--i:2">{s.p}</p>
      <ul class="checks" role="list">
        {s.checks.map((c, i) => <li class="reveal" style={`--i:${i + 3}`}><span class="ck" aria-hidden="true"><Icon name="check" size={14} /></span>{c}</li>)}
      </ul>
    </div>

    <div class="device reveal-scale" style="--i:2">
      <span class="device-tag"><Icon name="phone" size={14} />{s.device}</span>
      <div class="flow-wrap">
        <span class="pulse" aria-hidden="true"></span>
        <ol class="flow" role="list">
          {s.flow.map((f, i) => (
            <li class="step" style={`--k:${i}`}>
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <div><b>{f.b}</b><small>{f.s}</small></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <div class="wrap">
    <ol class="principles" role="list">
      {s.principles.map((p, i) => (
        <li class="pr reveal" style={`--i:${i}`}>
          <span class="k">0{i + 1}</span>
          <h3>{p.h}</h3>
          <p>{p.p}</p>
        </li>
      ))}
    </ol>

    <!-- Plain-language reassurance: what "local AI" means, and what it can't do -->
    <div class="local reveal" id="local-ai">
      <div class="local-copy">
        <!-- Illustration: the phone (with the CycleBuddy mark) inside a dashed boundary; data dots orbit but stay inside -->
        <svg class="art" viewBox="0 0 240 240" aria-hidden="true">
          <defs>
            <linearGradient id="art-t" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2DA9A0" /><stop offset="1" stop-color="#1B716B" /></linearGradient>
            <linearGradient id="art-l" gradientUnits="userSpaceOnUse" x1="80" y1="80" x2="940" y2="940"><stop offset="0" stop-color="#CC3466" /><stop offset="1" stop-color="#800020" /></linearGradient>
            <radialGradient id="art-glow"><stop offset="0" stop-color="#fff" stop-opacity=".95" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></radialGradient>
          </defs>
          <circle cx="120" cy="120" r="112" fill="url(#art-glow)" />
          <g class="ring"><circle cx="120" cy="120" r="100" fill="none" stroke="#2DA9A0" stroke-width="2" stroke-dasharray="5 8" stroke-linecap="round" /></g>
          <g class="orbit">
            <circle cx="120" cy="34" r="6" fill="#CC3466" />
            <circle cx="194" cy="163" r="5" fill="#2DA9A0" />
            <circle cx="46" cy="163" r="4.5" fill="#800020" />
          </g>
          <g class="device">
            <rect x="79" y="46" width="82" height="146" rx="18" fill="#fff" stroke="#3B2A2E" stroke-width="5" />
            <rect x="106" y="54" width="28" height="6" rx="3" fill="#3B2A2E" />
            <svg x="96" y="80" width="48" height="42" viewBox={LOGO_VIEWBOX}>
              <g fill="none" stroke-width={LOGO_STROKE} stroke-linecap="round" stroke-linejoin="round">
                <path d={LOGO_B} stroke="url(#art-l)" />
                <path d={LOGO_A} stroke="#fff" stroke-width={LOGO_STROKE + 28} stroke-linecap="butt" />
                <path d={LOGO_A} stroke="url(#art-l)" />
              </g>
            </svg>
            <rect x="96" y="136" width="48" height="7" rx="3.5" fill="#F3E6DC" />
            <rect x="104" y="149" width="32" height="7" rx="3.5" fill="#F3E6DC" />
          </g>
          <g class="badge-s">
            <circle cx="160" cy="176" r="24" fill="url(#art-t)" stroke="#fff" stroke-width="5" />
            <path d="M160 163.5s9 4.2 9 3.2v7.3c0 6.6-9 11.2-9 11.2s-9-4.6-9-11.2v-7.3c0 1 9-3.2 9-3.2z" fill="#fff" fill-opacity=".25" stroke="#fff" stroke-width="2.4" stroke-linejoin="round" />
            <path d="m155.5 175 3.2 3.2 6-6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </svg>
        <h3>{s.localH}</h3>
        <p>{s.localP}</p>
        <a class="text-link" href={`${localize(lang, '/faq/')}#ai`}>{s.localMore}<Icon name="arrow" size={16} class="arrow" /></a>
      </div>
      <ul class="local-list" role="list">
        {s.localItems.map((it, i) => (
          <li style={`--i:${i}`}><span class="li-ic gloss" aria-hidden="true"><Icon name={(['eye', 'hand', 'code'] as const)[i]} size={22} /></span><span>{it}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  .lead { margin-top: 18px; }
  .checks { list-style: none; margin-top: 28px; display: grid; gap: 14px; }
  .checks li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; }
  .ck { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--teal-soft); color: var(--teal-ink); margin-top: 1px; }

  /* The dashed "device" boundary: animated marching border, nothing crosses it */
  .device { position: relative; padding: 52px clamp(16px, 3vw, 28px) 28px; border-radius: 32px; background: rgba(255,255,255,.45); border: 2px dashed var(--teal); }
  .device-tag { position: absolute; top: -16px; left: 50%; translate: -50% 0; display: inline-flex; align-items: center; gap: 8px; background: var(--ivory); border: 1px solid var(--teal); color: var(--teal-ink); font-size: 13px; font-weight: 600; padding: 6px 14px; border-radius: 999px; width: max-content; max-width: calc(100% - 24px); text-align: center; }
  .flow-wrap { position: relative; }
  .flow-wrap::before { content: ''; position: absolute; left: 39px; top: 36px; bottom: 36px; width: 2px; background: var(--beige); z-index: 1; }
  .pulse { position: absolute; z-index: 2; left: 34px; top: 30px; width: 12px; height: 12px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 6px rgba(204,52,102,.18); animation: travel 4.5s var(--ease) infinite; }
  @keyframes travel { 0% { top: 30px; opacity: 0; } 10%, 85% { opacity: 1; } 100% { top: calc(100% - 42px); opacity: 0; } }
  .flow { display: grid; gap: 18px; list-style: none; }
  .step { position: relative; display: flex; align-items: center; gap: 16px; background: var(--white); border-radius: 20px; padding: 18px 20px; box-shadow: var(--shadow); animation: glow 4.5s var(--ease) infinite; animation-delay: calc(var(--k) * 1.35s); }
  @keyframes glow { 0%, 30%, 100% { box-shadow: var(--shadow); } 12% { box-shadow: 0 0 0 2px var(--pink-soft), 0 20px 40px -22px rgba(204,52,102,.7); } }
  .dot { position: relative; z-index: 3; flex: none; width: 38px; height: 38px; border-radius: 50%; background: var(--pink-soft); color: var(--burgundy); display: grid; place-items: center; font-weight: 700; font-size: 14px; }
  .step b { display: block; font-size: 15.5px; }
  .step small { color: var(--muted); font-size: 14px; }

  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: clamp(60px, 8vw, 90px); list-style: none; }
  .pr { position: relative; background: var(--white); border-radius: var(--r); padding: 30px 26px; border: 1px solid #F1E4DA; box-shadow: var(--shadow); overflow: hidden; transition: transform .4s var(--ease), box-shadow .4s var(--ease); }
  .pr::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--grad); transform: scaleX(.25); transform-origin: left; transition: transform .6s var(--ease); }
  .pr:nth-child(even)::before { background: linear-gradient(90deg, var(--teal-ink), var(--teal)); }
  .pr:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  .pr:hover::before { transform: scaleX(1); }
  .k { font-size: 12px; font-weight: 700; letter-spacing: .14em; color: var(--teal-ink); }
  .pr h3 { font-size: 32px; margin: 8px 0; }
  .pr p { color: var(--muted); font-size: 15px; }
  .local { margin-top: 26px; display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(24px, 4vw, 56px); align-items: center; background: linear-gradient(135deg, var(--teal-soft), #F2FAF8 55%, var(--white)); border: 1px solid #C9E7E2; border-radius: var(--r-lg); padding: clamp(28px, 4vw, 48px); }
  .local-copy { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .art { width: 200px; height: 200px; margin-bottom: 6px; overflow: visible; }
  .ring { transform-origin: 120px 120px; animation: spin 40s linear infinite; }
  .orbit { transform-origin: 120px 120px; animation: spin 16s linear infinite reverse; }
  .device { animation: hover 6s ease-in-out infinite; }
  .badge-s { transform-origin: 160px 176px; animation: beat 3s ease-in-out infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes hover { 50% { transform: translateY(-4px); } }
  @keyframes beat { 0%, 100% { transform: scale(1); } 12% { transform: scale(1.1); } 24% { transform: scale(1); } }
  .local h3 { font-size: clamp(28px, 3vw, 36px); }
  .local-copy p { color: var(--muted); margin: 12px auto 16px; max-width: 460px; }
  .local-list { list-style: none; display: grid; gap: 14px; }
  .local-list li { display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,.9); border: 1px solid #DCEFEC; border-radius: 18px; padding: 16px 20px 16px 16px; font-size: 15.5px; box-shadow: 0 12px 28px -22px rgba(27,113,107,.6); transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
  .local-list li:hover { transform: translateX(6px); box-shadow: 0 18px 32px -20px rgba(27,113,107,.6); }
  .li-ic { flex: none; width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--teal), var(--teal-ink)); box-shadow: 0 10px 18px -10px rgba(27,113,107,.9); }
  .local-list li:nth-child(2) .li-ic { background: linear-gradient(135deg, var(--pink), var(--burgundy)); box-shadow: 0 10px 18px -10px rgba(128,0,32,.8); }
  :global(.js) .local.in .local-list li { animation: slidein .7s var(--ease) both; animation-delay: calc(.2s + var(--i) * .15s); }
  @keyframes slidein { from { opacity: 0; transform: translateX(18px); } }
  @media (max-width: 860px) { .local { grid-template-columns: 1fr; } }
  @media (max-width: 980px) { .principles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .principles { grid-template-columns: 1fr; } }
</style>
