---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const s = t(Astro.props.lang).data;
const icons = ['phone', 'cloud', 'flask', 'code'] as const;
---
<section class="data" id="privacy">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow reveal">{s.eyebrow}</p>
    <h2 class="reveal" style="--i:1">{s.h}</h2>
    <p class="lead reveal" style="--i:2">{s.p}</p>
    <ul class="pgrid" role="list">
      {s.cards.map((c, i) => (
        <li class:list={['pcard reveal', { def: i === 0 }]} style={`--i:${i}`}>
          <div class="head">
            <span class="pi gloss" aria-hidden="true"><Icon name={icons[i]} size={20} /></span>
            <span class="k">{c.k}</span>
          </div>
          <h3>{c.h}</h3>
          <p>{c.p}</p>
        </li>
      ))}
    </ul>
    <p class="honest reveal">
      <span class="hi" aria-hidden="true"><Icon name="flag" size={18} /></span>
      <span><b>{s.honestB}</b> {s.honest}</span>
    </p>
  </div>
</section>

<style>
  .data { background: linear-gradient(160deg, #5C0017 0%, #800020 55%, #9E1F45 100%); color: #fff; overflow: hidden; }
  .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(600px 400px at 15% 0%, rgba(204,52,102,.45), transparent 70%), radial-gradient(500px 380px at 100% 100%, rgba(45,169,160,.28), transparent 70%); animation: breathe 14s ease-in-out infinite alternate; }
  @keyframes breathe { to { transform: scale(1.15) translate(2%, -2%); opacity: .8; } }
  .wrap { position: relative; }
  h2 { color: #fff; }
  .eyebrow { color: #9FE3DC; }
  .eyebrow::before { background: #9FE3DC; }
  .lead { color: rgba(255,255,255,.88); margin-top: 16px; }
  .pgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 56px; list-style: none; }
  .pcard { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.16); border-radius: var(--r); padding: 26px 24px; transition: background-color .4s, transform .4s var(--ease), border-color .4s; }
  .pcard:hover { background: rgba(255,255,255,.12); transform: translateY(-6px); border-color: rgba(255,255,255,.3); }
  .pcard.def { background: rgba(255,255,255,.14); border-color: rgba(159,227,220,.55); }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pi { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; background: rgba(255,255,255,.12); color: #fff; }
  .def .pi { background: var(--teal-ink); }
  .k { font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: #FFE3EA; font-weight: 700; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; padding: 4px 10px; }
  .def .k { color: #0F4541; background: #9FE3DC; border-color: transparent; }
  .pcard h3 { color: #fff; font-size: 26px; margin: 18px 0 8px; }
  .pcard p { font-size: 14.5px; color: rgba(255,255,255,.88); }
  .honest { margin-top: 34px; display: flex; gap: 14px; align-items: flex-start; background: rgba(0,0,0,.18); border-radius: 18px; padding: 20px 24px; font-size: 15px; color: rgba(255,255,255,.92); max-width: 860px; }
  .honest b { color: #fff; }
  .hi { flex: none; color: #FFD9E3; margin-top: 2px; }
  @media (max-width: 980px) { .pgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pgrid { grid-template-columns: 1fr; } }
</style>
