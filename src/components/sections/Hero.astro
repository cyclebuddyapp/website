---
import Phone from '../Phone.astro';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).hero;
const icons = ['phone', 'book', 'code', 'globe'] as const;
---
<section class="hero" id="top">
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="pill rise" style="--d:0"><i aria-hidden="true"></i>{s.pill}</p>
      <h1>
        <span class="line"><span class="rise" style="--d:1">{s.h1a}</span></span>
        <span class="line"><em class="rise grad-text" style="--d:2">{s.h1b}</em></span>
      </h1>
      <p class="lead rise" style="--d:3">{s.lead}</p>
      <div class="ctas rise" style="--d:4">
        <a href="#waitlist" class="btn btn-primary">{s.ctaWait}<Icon name="arrow" size={18} class="arrow" /></a>
        <a href="#privacy" class="btn btn-ghost">{s.ctaHow}</a>
      </div>
      <ul class="trust rise" style="--d:5" role="list">
        {s.trust.map((x, i) => <li><span class="ti gloss"><Icon name={icons[i]} size={15} /></span>{x}</li>)}
      </ul>
    </div>
    <div class="visual rise-scale">
      <Phone lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(40px, 7vw, 90px) 0 clamp(70px, 9vw, 110px); overflow: hidden; }
  .aurora { position: absolute; inset: -10% -10% 0; z-index: -1; pointer-events: none; filter: blur(60px); opacity: .75; }
  .aurora i { position: absolute; border-radius: 50%; }
  .aurora i:nth-child(1) { width: 46vw; height: 46vw; max-width: 620px; max-height: 620px; left: -8%; top: -12%; background: radial-gradient(circle, rgba(204,52,102,.30), transparent 65%); animation: drift1 22s ease-in-out infinite; }
  .aurora i:nth-child(2) { width: 40vw; height: 40vw; max-width: 560px; max-height: 560px; right: -6%; top: 10%; background: radial-gradient(circle, rgba(45,169,160,.24), transparent 65%); animation: drift2 26s ease-in-out infinite; }
  .aurora i:nth-child(3) { width: 34vw; height: 34vw; max-width: 460px; max-height: 460px; left: 34%; bottom: -14%; background: radial-gradient(circle, rgba(128,0,32,.16), transparent 65%); animation: drift1 30s ease-in-out -8s infinite reverse; }
  @keyframes drift1 { 50% { transform: translate(8%, 10%) scale(1.12); } }
  @keyframes drift2 { 50% { transform: translate(-10%, 8%) scale(.92); } }

  .hero-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(30px, 5vw, 70px); align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 10px; background: rgba(255,255,255,.85); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font-size: 13.5px; color: var(--burgundy); font-weight: 500; margin-bottom: 26px; }
  .pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--pink); animation: beacon 2.4s ease-out infinite; }
  @keyframes beacon { 0% { box-shadow: 0 0 0 0 rgba(204,52,102,.55); } 100% { box-shadow: 0 0 0 12px rgba(204,52,102,0); } }
  h1 .line { display: block; overflow: hidden; padding-bottom: .08em; }
  h1 .line > * { display: inline-block; }
  h1 em { font-style: italic; }
  .lead { margin: 24px 0 34px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .trust { display: flex; gap: 10px 22px; flex-wrap: wrap; margin-top: 36px; font-size: 14px; color: var(--muted); list-style: none; }
  .trust li { display: flex; align-items: center; gap: 8px; }
  .ti { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: var(--teal-soft); color: var(--teal-ink); }

  /* entrance */
  .rise { animation: rise 1s var(--ease) both; animation-delay: calc(.15s + var(--d) * .12s); }
  h1 .rise { animation-name: rise-line; }
  .rise-scale { animation: rise-scale 1.3s var(--ease) .35s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  @keyframes rise-line { from { opacity: 0; transform: translateY(105%); } }
  @keyframes rise-scale { from { opacity: 0; transform: translateY(30px) scale(.94); } }

  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; }
    .visual { margin-top: 10px; }
  }
</style>
