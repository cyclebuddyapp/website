---
import Form from '../Form.astro';
import Logo from '../Logo.astro';
import { t, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).cta;
---
<section class="cta" id="waitlist">
  <div class="wrap">
    <div class="box reveal-scale">
      <div class="deco" aria-hidden="true"><Logo id="cta-logo" class="deco-logo" /></div>
      <div class="intro">
        <p class="eyebrow">{s.eyebrow}</p>
        <h2>{s.h}</h2>
        <p class="lead">{s.p}</p>
      </div>
      <div class="forms">
        <div class="panel main">
          <h3>{s.waitlistH}</h3>
          <Form kind="waitlist" lang={lang} id="waitlist-form" />
        </div>
        <div class="panel" id="contact">
          <h3>{s.contactH}</h3>
          <p class="sub">{s.contactP}</p>
          <Form kind="contact" lang={lang} id="contact-form" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-top: clamp(40px, 5vw, 70px); }
  .box { position: relative; overflow: hidden; background: var(--white); border-radius: var(--r-lg); padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 56px); box-shadow: var(--shadow-lg); border: 1px solid #F1E4DA; }
  .deco { position: absolute; right: -60px; top: -50px; width: 300px; opacity: .07; pointer-events: none; animation: sway 16s ease-in-out infinite; }
  .deco :global(svg) { width: 100%; height: auto; }
  @keyframes sway { 50% { transform: rotate(10deg) translateY(16px); } }
  .intro { position: relative; text-align: center; max-width: 680px; margin: 0 auto; }
  .intro .eyebrow::after { content: ''; width: 22px; height: 2px; border-radius: 2px; background: var(--teal); }
  .intro .lead { margin: 14px auto 0; }
  .forms { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 44px; align-items: start; }
  .panel { border-radius: 22px; padding: clamp(22px, 3vw, 32px); background: var(--ivory-2); border: 1px solid var(--line); }
  .panel.main { background: linear-gradient(160deg, #FFF5F7, var(--ivory-2)); border-color: #EFC9D5; }
  .panel h3 { margin-bottom: 18px; }
  .sub { color: var(--muted); font-size: 15px; margin: -10px 0 18px; }
  @media (max-width: 860px) { .forms { grid-template-columns: 1fr; } }
</style>
