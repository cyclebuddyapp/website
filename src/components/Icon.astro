---
// Small inline duotone icons (no icon font, no external requests). Decorative by default.
// Each icon = a soft tinted fill ("duo", 20% of the current color) under a crisp line drawing.
interface Props { name: keyof typeof icons; size?: number; class?: string; label?: string; duo?: boolean }
const icons = {
  calendar: ['<rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" stroke-width="2.6"/>', '<path d="M6 4h12a3 3 0 0 1 3 3v3H3V7a3 3 0 0 1 3-3z"/>'],
  book: ['<path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/>', '<path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/>'],
  sparkle: ['<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7zM5 3.5l.5 1.2 1.2.5-1.2.5L5 6.9l-.5-1.2-1.2-.5 1.2-.5z"/>', '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>'],
  leaf: ['<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6"/>', '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/>'],
  activity: ['<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>', ''],
  heart: ['<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>', '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>'],
  users: ['<circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2M16 3.1a4 4 0 0 1 0 7.8M21 21v-2a4 4 0 0 0-3-3.9"/>', '<circle cx="9" cy="7" r="4"/>'],
  lock: ['<rect x="4" y="11" width="16" height="11" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 15.5v2"/>', '<rect x="4" y="11" width="16" height="11" rx="2.5"/>'],
  play: ['<path d="M7 4.5v15a1 1 0 0 0 1.5.9l12-7.5a1 1 0 0 0 0-1.8l-12-7.5A1 1 0 0 0 7 4.5z" fill="currentColor" stroke="none"/>', ''],
  check: ['<path d="M20 6 9 17l-5-5"/>', ''],
  shield: ['<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>', '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'],
  phone: ['<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/>', '<rect x="6" y="2" width="12" height="20" rx="3"/>'],
  cloud: ['<path d="M17.5 19H8a6 6 0 1 1 1.3-11.9A5 5 0 0 1 19 9a4.5 4.5 0 0 1-1.5 10z"/><path d="M12 12v4M10.5 13.5 12 12l1.5 1.5"/>', '<path d="M17.5 19H8a6 6 0 1 1 1.3-11.9A5 5 0 0 1 19 9a4.5 4.5 0 0 1-1.5 10z"/>'],
  flask: ['<path d="M9 3h6M10 3v6L4.5 19a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 9V3"/><path d="M7 15h10"/>', '<path d="M7 15h10l2.5 4a2 2 0 0 1-1.8 3H6.3a2 2 0 0 1-1.8-3z"/>'],
  code: ['<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/><path d="m14 4-4 16"/>', ''],
  refresh: ['<path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/>', ''],
  arrow: ['<path d="M5 12h14M13 6l6 6-6 6"/>', ''],
  globe: ['<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>', '<circle cx="12" cy="12" r="10"/>'],
  eye: ['<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>', '<circle cx="12" cy="12" r="3"/>'],
  hand: ['<path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.4l-3.6-3.6a2 2 0 0 1 2.8-2.8L7 15"/>', '<path d="M6 14V6a2 2 0 0 1 4 0V4a2 2 0 0 1 4 0v2a2 2 0 0 1 4 0v2a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.4l-3.6-3.6a2 2 0 0 1 2.8-2.8L7 15z"/>'],
  mail: ['<rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/>', '<rect x="2" y="4" width="20" height="16" rx="3"/>'],
  flag: ['<path d="M4 22V4s1.5-1 5-1 5 2 8 2 3-1 3-1v11s-1 1-3 1-5-2-8-2-5 1-5 1"/>', '<path d="M4 4s1.5-1 5-1 5 2 8 2 3-1 3-1v11s-1 1-3 1-5-2-8-2-5 1-5 1z"/>'],
} as const;
const { name, size = 20, class: cls, label, duo = true } = Astro.props;
const [line, fill] = icons[name];
const html = (duo && fill ? `<g fill="currentColor" stroke="none" opacity=".2">${fill}</g>` : '') + line;
---
<svg
  class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false"
  set:html={html}
/>
