---
// Hero phone mockup. Three app screens crossfade slowly (CSS only, 6s each).
// Decorative: hidden from screen readers, described by a single label instead.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const s = t(Astro.props.lang);
const p = s.phone;
// Cycle ring for screen 2: 28 days, day 14 highlighted
const days = Array.from({ length: 28 }, (_, i) => i + 1);
const phaseColor = (d: number) => (d <= 5 ? '#CC3466' : d <= 12 ? '#2DA9A0' : d <= 16 ? '#E7A33E' : '#800020');
---
<div class="phone-stage" role="img" aria-label={s.hero.phoneLabel}>
  <!-- slow rotating cycle ring behind the phone -->
  <svg class="ring" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="186" fill="none" stroke="#EADFCF" stroke-width="1.5" stroke-dasharray="2 8" />
    <circle cx="200" cy="200" r="168" fill="none" stroke="url(#ring-g)" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="17 3 23 3 13 3 35 3" />
    <defs>
      <linearGradient id="ring-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#CC3466" /><stop offset=".45" stop-color="#2DA9A0" /><stop offset="1" stop-color="#800020" />
      </linearGradient>
    </defs>
    <circle class="orbit" cx="200" cy="32" r="9" fill="#fff" stroke="#CC3466" stroke-width="4" />
  </svg>

  <div class="phone" aria-hidden="true">
    <div class="screen">
      <div class="notch"></div>

      <!-- Screen 1: home -->
      <div class="slide s1">
        <div class="scr-hi">{p.hi}</div>
        <div class="scr-title">{p.day}</div>
        <div class="track">
          <div class="ic"><Icon name="calendar" size={18} /></div>
          <div><b>{p.track}</b><small>{p.trackS}</small></div>
        </div>
        <div class="grid2">
          <div class="tile"><span class="tag free">{p.free}</span><div class="tic" style="background:#F7DDE4;color:#A8264F"><Icon name="book" size={16} /></div><b>{p.learn}</b><small>{p.learnS}</small></div>
          <div class="tile"><div class="tic" style="background:#DDF1EE;color:#1B716B"><Icon name="sparkle" size={16} /></div><b>{p.align}</b><small>{p.alignS}</small></div>
        </div>
        <div class="divider"></div>
        <div class="grid2">
          <div class="tile"><span class="tag pro">{p.pro}</span><div class="tic" style="background:#E7F4EC;color:#2E7D4F"><Icon name="leaf" size={16} /></div><b>{p.nourish}</b><small>{p.nourishS}</small></div>
          <div class="tile"><span class="tag pro">{p.pro}</span><div class="tic" style="background:#E6F1FB;color:#2A5F94"><Icon name="activity" size={16} /></div><b>{p.move}</b><small>{p.moveS}</small></div>
          <div class="tile"><span class="tag pro">{p.pro}</span><div class="tic" style="background:#FDECEE;color:#A8264F"><Icon name="heart" size={16} /></div><b>{p.intimacy}</b><small>{p.intimacyS}</small></div>
          <div class="tile"><span class="tag pro">{p.pro}</span><div class="tic" style="background:#F1ECFB;color:#5B3FA0"><Icon name="users" size={16} /></div><b>{p.partner}</b><small>{p.partnerS}</small></div>
        </div>
      </div>

      <!-- Screen 2: logging today -->
      <div class="slide s2">
        <div class="scr-hi">{p.logSub}</div>
        <div class="scr-title">{p.logTitle}</div>
        <div class="cycle">
          <svg viewBox="0 0 200 200">
            {days.map((d) => {
              const a = ((d - 1) / 28) * Math.PI * 2 - Math.PI / 2;
              const r = 80;
              return <circle cx={100 + r * Math.cos(a)} cy={100 + r * Math.sin(a)} r={d === 14 ? 9 : 5} fill={phaseColor(d)} opacity={d === 14 ? 1 : 0.55} class={d === 14 ? 'today' : undefined} />;
            })}
          </svg>
          <div class="cycle-mid"><b>14</b><small>{p.logCycle}</small></div>
        </div>
        <div class="chips">
          {p.logChips.map((c, i) => <span class:list={['chip', { on: i < 3 }]} style={`--d:${i}`}>{c}</span>)}
        </div>
        <div class="saved"><Icon name="lock" size={14} />{p.logSaved}</div>
      </div>

      <!-- Screen 3: learn episode -->
      <div class="slide s3">
        <div class="scr-hi">{p.epLevel}</div>
        <div class="scr-title">{p.learn}</div>
        <div class="video">
          <div class="friends"><i></i><i></i><i></i></div>
          <div class="play"><Icon name="play" size={22} /></div>
          <span class="len">{p.epLen}</span>
          <div class="bar"><i></i></div>
        </div>
        <b class="ep-title">{p.epTitle}</b>
        <small class="ep-note">{p.epNote}</small>
        <div class="quiz"><Icon name="sparkle" size={14} />{p.epNext}</div>
      </div>

      <div class="tabbar"><span>{p.tabTrack}</span><span>{p.tabCircle}</span><span class="home"></span><span>{p.tabLearn}</span><span>{p.tabAlign}</span></div>
    </div>
  </div>

  <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>

  <!-- floating badges -->
  <div class="float f1" aria-hidden="true"><span class="fi" style="background:#DDF1EE;color:#1B716B"><Icon name="lock" size={16} /></span>{s.data.cards[0].h}</div>
  <div class="float f2" aria-hidden="true"><span class="fi" style="background:#F7DDE4;color:#A8264F"><Icon name="sparkle" size={16} /></span>{s.hero.trust[0]}</div>
</div>

<style>
  .phone-stage { position: relative; width: min(100%, 440px); aspect-ratio: 1 / 1.22; margin: 0 auto; display: grid; place-items: center; }
  .ring { position: absolute; width: 112%; max-width: none; top: 50%; left: 50%; translate: -50% -52%; animation: spin 90s linear infinite; opacity: .9; }
  .orbit { filter: drop-shadow(0 4px 6px rgba(204,52,102,.4)); }
  @keyframes spin { to { rotate: 360deg; } }

  .phone { position: relative; z-index: 2; width: 290px; background: #1F1A1B; border-radius: 46px; padding: 11px; box-shadow: 0 50px 90px -34px rgba(128,0,32,.55), inset 0 0 0 2px #3a3233; animation: float 7s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-10px); } }
  .screen { position: relative; background: #FBF7F4; border-radius: 36px; overflow: hidden; height: 580px; }
  .notch { position: absolute; z-index: 3; top: 11px; left: 50%; transform: translateX(-50%); width: 88px; height: 24px; background: #1F1A1B; border-radius: 20px; }

  .slide { position: absolute; inset: 0; padding: 46px 16px 70px; animation: screen 18s var(--ease) infinite both; }
  .s2 { animation-delay: 6s; }
  .s3 { animation-delay: 12s; }
  @keyframes screen {
    0% { opacity: 0; transform: translateX(26px); }
    4%, 30% { opacity: 1; transform: none; }
    34%, 100% { opacity: 0; transform: translateX(-26px); }
  }

  .scr-hi { font-size: 12px; color: var(--muted); }
  .scr-title { font-family: var(--serif); font-size: 25px; color: var(--burgundy); font-weight: 700; margin-bottom: 12px; line-height: 1.1; }
  .track { background: linear-gradient(135deg, #8E1B3F, #C2385F); color: #fff; border-radius: 18px; padding: 14px; display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
  .track .ic { width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,.2); display: grid; place-items: center; flex: none; }
  .track b { font-size: 14px; display: block; }
  .track small { font-size: 11px; opacity: .88; line-height: 1.35; display: block; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .tile { background: #fff; border-radius: 16px; padding: 11px 8px; text-align: center; box-shadow: 0 4px 14px -10px rgba(0,0,0,.3); position: relative; }
  .tic { width: 32px; height: 32px; border-radius: 10px; margin: 0 auto 6px; display: grid; place-items: center; }
  .tile b { font-size: 12px; display: block; color: var(--ink); }
  .tile small { font-size: 10px; color: var(--muted); display: block; line-height: 1.3; }
  .tag { position: absolute; top: 6px; right: 6px; font-size: 8px; font-weight: 700; padding: 2px 6px; border-radius: 6px; }
  .tag.free { background: #E7F4EC; color: #2E7D4F; }
  .tag.pro { background: #FFF1D6; color: #8A6410; }
  .divider { height: 1px; background: var(--line); margin: 11px 4px; }
  .tabbar { position: absolute; z-index: 3; bottom: 0; left: 0; right: 0; height: 58px; background: #fff; border-top: 1px solid var(--line); display: flex; justify-content: space-around; align-items: center; font-size: 9px; color: var(--muted); }
  .tabbar .home { width: 42px; height: 42px; border-radius: 50%; background: var(--grad); margin-top: -24px; border: 4px solid #fff; box-shadow: 0 6px 14px -6px rgba(128,0,32,.6); }

  /* screen 2 */
  .cycle { position: relative; width: 196px; margin: 4px auto 14px; }
  .cycle svg { width: 100%; height: auto; }
  .today { animation: pulse 2s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes pulse { 50% { transform: scale(1.35); } }
  .cycle-mid { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .cycle-mid b { font-family: var(--serif); font-size: 52px; line-height: 1; color: var(--burgundy); }
  .cycle-mid small { font-size: 11px; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; justify-content: center; }
  .chip { font-size: 11.5px; font-weight: 600; padding: 7px 11px; border-radius: 999px; background: #fff; border: 1px solid var(--line); color: var(--muted); }
  .chip.on { background: var(--pink-soft); border-color: #EBB5C6; color: #8E1B3F; animation: pop 18s var(--ease) infinite both; animation-delay: calc(6s + var(--d) * .35s); }
  @keyframes pop { 0%, 3% { transform: scale(.6); opacity: 0; } 6%, 100% { transform: none; opacity: 1; } }
  .saved { margin: 16px auto 0; width: fit-content; display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: #1B716B; background: var(--teal-soft); border-radius: 999px; padding: 6px 12px; }

  /* screen 3 */
  .video { position: relative; height: 200px; border-radius: 20px; overflow: hidden; background: linear-gradient(140deg, #F4C9D5, #F9EEE4 45%, #CDEBE7); margin-bottom: 14px; }
  .friends { position: absolute; left: 50%; bottom: 0; translate: -50% 0; display: flex; gap: 6px; align-items: flex-end; }
  .friends i { display: block; width: 46px; height: 74px; border-radius: 23px 23px 6px 6px; background: #CC3466; }
  .friends i:nth-child(2) { height: 92px; background: #800020; }
  .friends i:nth-child(3) { background: #2DA9A0; }
  .friends i::before { content: ''; display: block; width: 30px; height: 30px; border-radius: 50%; margin: -34px auto 0; background: #F2C8A8; }
  .friends i:nth-child(2)::before { background: #C99572; }
  .friends i:nth-child(3)::before { background: #8D5E45; }
  .play { position: absolute; top: 38%; left: 50%; translate: -50% -50%; width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.92); color: var(--burgundy); box-shadow: 0 0 0 0 rgba(255,255,255,.7); animation: ripple 2.2s ease-out infinite; }
  @keyframes ripple { to { box-shadow: 0 0 0 18px rgba(255,255,255,0); } }
  .len { position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 700; color: #fff; background: rgba(43,35,36,.6); padding: 2px 7px; border-radius: 6px; }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(255,255,255,.5); }
  .bar i { display: block; height: 100%; width: 100%; background: var(--pink); transform-origin: left; animation: bar 18s linear infinite both; animation-delay: 12s; }
  @keyframes bar { 0% { transform: scaleX(0); } 33% { transform: scaleX(.85); } 100% { transform: scaleX(.85); } }
  .ep-title { display: block; font-size: 15px; color: var(--ink); }
  .ep-note { display: block; font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.4; }
  .quiz { margin-top: 14px; display: flex; align-items: center; gap: 6px; width: fit-content; font-size: 11px; font-weight: 600; color: #8A6410; background: #FFF1D6; border-radius: 999px; padding: 6px 12px; }

  /* progress dots under the phone */
  .dots { position: absolute; z-index: 3; bottom: -2px; left: 50%; translate: -50% 0; display: flex; gap: 8px; }
  .dots i { width: 22px; height: 4px; border-radius: 4px; background: var(--beige); overflow: hidden; position: relative; }
  .dots i::after { content: ''; position: absolute; inset: 0; background: var(--burgundy); transform-origin: left; animation: dot 18s linear infinite both; }
  .dots i:nth-child(2)::after { animation-delay: 6s; }
  .dots i:nth-child(3)::after { animation-delay: 12s; }
  @keyframes dot { 0% { transform: scaleX(0); } 33.3% { transform: scaleX(1); } 33.4%, 100% { transform: scaleX(0); } }

  .float { position: absolute; z-index: 3; display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border: 1px solid #F1E4DA; border-radius: 16px; padding: 10px 14px 10px 10px; font-size: 13px; font-weight: 600; color: var(--ink); box-shadow: var(--shadow); white-space: nowrap; }
  .fi { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; }
  .f1 { left: -6%; top: 22%; animation: bob 6s ease-in-out infinite; }
  .f2 { right: -8%; bottom: 20%; animation: bob 6s ease-in-out -3s infinite; }
  @keyframes bob { 50% { transform: translateY(-12px); } }

  @media (max-width: 560px) {
    .phone { width: 260px; }
    .screen { height: 556px; }
    .f1 { left: 0; top: -2%; }
    .f2 { right: 0; bottom: 8%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide { animation: none !important; opacity: 0; }
    .s1 { opacity: 1; }
    .chip.on, .bar i { animation: none !important; }
    .dots { display: none; }
  }
</style>
